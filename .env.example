# Movi Exporter App - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# WIALON CONFIGURATION (Required)
# ============================================================
# Token de acesso à API Wialon
# Obtenha em: Wialon > Gestão de Usuários > Token de Acesso
WIALON_TOKEN=your_wialon_api_token_here

# ============================================================
# EXPORT SETTINGS (Optional)
# ============================================================
# Diretório onde os arquivos serão exportados
EXPORT_DIR=./exports

# Quantidade de mensagens por página na busca de histórico
# Valores recomendados: 500-2000
WIALON_PAGE_SIZE=1000
