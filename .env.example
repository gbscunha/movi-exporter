# ============================================================
# MOVI EXPORTER APP - CONFIGURAÇÕES
# ============================================================
# Copie este arquivo para .env e preencha os valores

# ============================================================
# WIALON (Obrigatório)
# ============================================================
# Token de acesso à API Wialon — gerado pelo fluxo de autorização web da Wialon
# (botão "Gerar" na tela Configurações do app; ver manual, seção 2)
WIALON_TOKEN=seu_token_wialon_aqui

# Segunda conta Wialon (opcional). Se preenchido, o app mostra o seletor de
# conta e a CLI aceita --account 2. Exports da conta 2 vão para YYYY-MM/<conta>/
WIALON_TOKEN_2=

# ============================================================
# EXPORTAÇÃO (Opcional)
# ============================================================
# Diretório onde os arquivos serão exportados
EXPORT_DIR=./exports

# Quantidade de mensagens por página na busca de histórico
WIALON_PAGE_SIZE=1000

# ============================================================
# GOOGLE DRIVE (Opcional - para upload automático)
# ============================================================
# Arquivo de credenciais OAuth2
GOOGLE_DRIVE_CREDENTIALS_FILE=./client_secrets.json

# ID da pasta no Google Drive onde os arquivos serão enviados
# Obtenha o ID na URL da pasta: https://drive.google.com/drive/folders/XXXXXXXX
GOOGLE_DRIVE_FOLDER_ID=seu_folder_id_aqui

# ============================================================
# INTERFACE (Opcional)
# ============================================================
# Tema da interface gráfica: dark (padrão), light ou system
APP_THEME=dark
